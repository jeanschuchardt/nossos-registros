GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opcional: pasta-mãe onde o create-event cria a pasta de cada evento.
GOOGLE_DRIVE_PARENT_FOLDER_ID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Obrigatória, com pelo menos 32 caracteres: openssl rand -base64 48
UPLOAD_SESSION_ENCRYPTION_KEY=
SESSION_RATE_LIMIT_PER_MINUTE=120
UPLOAD_PREPARATION_TIMEOUT_MS=120000
# Sem progresso por este tempo, a reserva de capacidade do upload é liberada (padrão: 2 h).
UPLOAD_ABANDONED_TIMEOUT_MS=7200000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
