{
  "name": "nossos-registros",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-database.ts",
    "db:check-uploads": "tsx --env-file=.env.local scripts/check-upload-schema.ts",
    "db:create-event": "tsx --env-file=.env.local scripts/create-event.ts",
    "db:list-events": "tsx --env-file=.env.local scripts/list-events.ts",
    "db:update-event": "tsx --env-file=.env.local scripts/update-event-status.ts",
    "check:google": "tsx --env-file=.env.local scripts/check-google.ts",
    "qr": "tsx --env-file=.env.local scripts/generate-qr.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
